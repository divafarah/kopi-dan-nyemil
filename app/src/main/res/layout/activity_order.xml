<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@color/cream">

    <TextView
        android:id="@+id/tvOrderGreeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Halo, Nama!"
        android:textColor="@color/cocoa"
        android:textSize="25sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/logo"
        android:scaleType="fitCenter"
        android:contentDescription="Logo Kopi dan Nyemil" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:gravity="center"
        android:text="Pesanan Berhasil!"
        android:textColor="@color/matcha_dark"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvOrderSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Pesanan kamu"
        android:textColor="@color/cocoa"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="Terima kasih sudah memesan. Tunggu aja sebentar, kurir kami segera mengantarkan pesananmu!"
        android:textColor="@color/gray"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnOrderOk"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="35dp"
        android:backgroundTint="@color/strawberry_dark"
        android:text="OK"
        android:textColor="@color/white"
        android:textStyle="bold" />

</LinearLayout>
